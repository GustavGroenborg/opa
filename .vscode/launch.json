{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug OPA eval (prebuild)",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "debugAdapter": "dlv-dap",
      "program": "${workspaceFolder}/opa-debug",
      "cwd": "${workspaceFolder}",
      "args": [
        "eval",
        "--data",
        "examples/policy.rego",
        "--input",
        "examples/input.json",
        "data.authz.allow"
      ]
    },
